{
    "archinstall-language": "English",
    "bootloader_config": {
        "bootloader": "Grub",
        "removable": true
    },
    "disk_config": {
        "config_type": "btrfs",
        "device": "/dev/sdb",
        "wipe": true
    },
    "hostname": "archlinux",
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "network_config": {
        "type": "iso"
    },
    "ntp": true,
    "packages": [
        "snap-pac",
        "grub-btrfs"
    ],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": "All open-source",
        "greeter": "sddm",
        "profile": {
            "details": [
                "Hyprland"
            ],
            "main": "Desktop"
        }
    },
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "Africa/Johannesburg",
    "version": "4.3"
}
