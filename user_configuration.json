{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        },
        "firewall_config": {
            "firewall": "ufw"
        },
        "power_management_config": {
            "power_management": "power-profiles-daemon"
        },
        "print_service_config": {
            "enabled": false
        }
    },
    "archinstall-language": "English",
    "bootloader_config": {
        "bootloader": "Grub",
        "removable": true,
        "uki": true
    },
    "hostname": "archlinux",
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "mirror_regions": {
            "South Africa": [
                "https://za.mirrors.cicku.me/archlinux/$repo/os/$arch",
                "https://archlinux.za.mirror.allworldit.com/archlinux/$repo/os/$arch",
                "https://johannesburg.mirror.pkgbuild.com/$repo/os/$arch"
            ]
        },
        "optional_repositories": [
            "multilib"
        ]
    },
    "network_config": {
        "type": "iso"
    },
    "ntp": true,
    "packages": [
        "snap-pac",
        "grub-btrfs"
    ],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": "All open-source",
        "greeter": "sddm",
        "profile": {
            "custom_settings": {
                "Hyprland": {
                    "seat_access": "polkit"
                }
            },
            "details": [
                "Hyprland"
            ],
            "main": "Desktop"
        }
    },
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "Africa/Johannesburg",
    "version": "4.3"
}
