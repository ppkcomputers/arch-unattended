#!ipxe

# 1. Bring up the network card
dhcp

# 2. Set mirror paths
set arch_mirror https://geo.mirror.pkgbuild.com

# 3. Load Kernel and explicitly grab the json config mapping directly from the root of the local USB drive file tree
kernel ${arch_mirror}/iso/latest/arch/boot/x86_64/vmlinuz-linux initrd=initramfs-linux.img archiso_http_srv=${arch_mirror}/iso/latest/ archisobasedir=arch ip=dhcp script=/user_configuration.json

# 4. Pull down the matching installation image
initrd ${arch_mirror}/iso/latest/arch/boot/x86_64/initramfs-linux.img

# 5. Boot the system
boot
